# ============================================================
# Arjun Sports AI Content Agent — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Database (PostgreSQL) ---
POSTGRES_DB=arjun_content_agent
POSTGRES_USER=arjun_admin
POSTGRES_PASSWORD=change_me_strong_password
DB_HOST=localhost
DB_PORT=5432
# Host-side port Docker Compose exposes Postgres on (change if 5432 is already
# taken on your machine by another project's database container).
POSTGRES_HOST_PORT=5433
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# --- JWT ---
# Any random string >= 32 characters (used as raw HMAC key bytes, not required to be base64).
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# --- Credential encryption ---
# Base64-encoded 256-bit (32-byte) AES key, e.g. generate with: openssl rand -base64 32
# Used to encrypt third-party credentials at rest (e.g. Instagram access tokens).
# Changing this after tokens have been stored makes them undecryptable - reconnect afterward.
APP_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key

# --- Auth cookies ---
# Secure=true requires HTTPS - set false only for plain-HTTP local dev.
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
# Leave empty for a host-only cookie. In production, if the frontend and backend
# are on different subdomains (app.example.com / api.example.com), set this to
# the shared parent domain (.example.com) so the browser sends the cookie to both.
COOKIE_DOMAIN=

# --- First admin account bootstrap (only used when the users table is empty) ---
ADMIN_BOOTSTRAP_EMAIL=admin@arjunsports.example
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_strong_password
ADMIN_BOOTSTRAP_FIRST_NAME=Academy
ADMIN_BOOTSTRAP_LAST_NAME=Admin

# --- Storage (MinIO / S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
# Host the browser will fetch presigned URLs from. In docker-compose this is
# overridden to http://localhost:9000 for the backend container specifically,
# since STORAGE_ENDPOINT there is the Docker-internal "http://minio:9000"
# (unreachable from outside the Compose network). Leave unset to reuse STORAGE_ENDPOINT.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=arjun_minio_admin
STORAGE_SECRET_KEY=change_me_minio_secret
STORAGE_BUCKET=arjun-content-media
STORAGE_REGION=us-east-1
# Set to true only when pointing STORAGE_ENDPOINT at real AWS S3
STORAGE_PATH_STYLE_ACCESS=true

# --- AI Provider (OpenAI-compatible) ---
# Which AIProvider bean is active. Only "openai" exists today; future values
# (gemini, claude, azure-openai, ollama) just need a new AIProvider bean.
AI_ACTIVE_PROVIDER=openai
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=replace_with_real_key
AI_PROVIDER_MODEL=gpt-4o-mini
AI_GENERATION_TIMEOUT_SECONDS=30
AI_GENERATION_MAX_TOKENS=700
AI_GENERATION_TEMPERATURE=0.8

# --- Instagram Graph API (Meta) — filled in when the academy's Meta app is ready ---
# active-publisher: "meta-graph-api" (real) or "mock" (dev/testing, no credentials needed).
# The dev profile defaults to "mock" regardless of this value unless explicitly overridden.
IG_ACTIVE_PUBLISHER=meta-graph-api
IG_GRAPH_API_BASE_URL=https://graph.facebook.com/v19.0
IG_APP_ID=
IG_APP_SECRET=
# Optional: if both of these are set and no account is connected yet, the app auto-connects
# on startup (see InstagramAccountBootstrapRunner). Otherwise connect via POST /api/instagram/connect.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# --- Frontend ---
# Browser-facing API URL (must be reachable from the user's machine).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# Server-side (proxy.ts, Server Components) API URL. Bare `npm run dev` uses
# localhost; docker-compose.yml overrides this to http://backend:8080/api
# since "localhost" inside the frontend container is the container itself.
API_INTERNAL_BASE_URL=http://localhost:8080/api
NODE_ENV=development

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
